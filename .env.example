# Local secrets. Never commit the real .env file.
#
# Setup:
#   1. Copy this file to .env
#   2. Paste your own key below
#   3. Run  .\sync-env.ps1   once
#   4. Restart the app (full stop and run again, hot reload is not enough)
#
# After step 3 the key is written to assets/env.txt and web/env.js, which is
# how the app reads it. That is what makes a plain `flutter run`, the Android
# Studio Run button, and a release APK all pick the key up with no
# --dart-define arguments.

# Groq — get a key at https://console.groq.com/keys
GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE

# Model to use for the AI advisor
GROQ_MODEL=openai/gpt-oss-120b
